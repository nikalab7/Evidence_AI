GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Must identify the Evidence_AI Supabase project; the app rejects another project ID.
DATABASE_URL=
ADMIN_TOKEN=
ENABLE_EMBEDDING_STARTUP_CHECK=false
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# Set a positive value only after checking this Gemini project's current RPD.
# A zero budget disables investigation requests until an operator configures it.
INVESTIGATION_DAILY_BUDGET=0
INVESTIGATION_PER_IP_PER_MINUTE=2
INVESTIGATION_MAX_CONCURRENT=2
INVESTIGATION_TIMEOUT_SECONDS=90
GEMINI_REQUEST_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1024
DATABASE_STATEMENT_TIMEOUT_MS=12000
INDEXED_DOCUMENT_COUNT=50000
